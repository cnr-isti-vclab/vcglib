# Rules to ignore all files without extension (binaries on unix)
# these rules must be above all the other rules
*
!/**/
!*.*

# Eigen's module headers have no extension, so the rule above ignores them.
# Already-tracked ones are unaffected, which makes the failure invisible: every
# Eigen update silently drops its *new* headers at "git add" time and only
# breaks on a case-sensitive filesystem. The vendored tree holds no built
# binaries, so exempt it wholesale; the *.o/*.a/.DS_Store rules further down
# still apply, being later matches.
!eigenlib/**

# Reference material for possible implementation (we put here papers for future reference).
.reference

# QTCreator user prefs
*.user

# Directories to ignore
build/
html/
debug/
release/
*-debug/
*-release/
/docs/Doxygen/html/
.vscode/

# Intermediate Files
*.bc

# osx rubbish
.DS_Store

# Visual Studio Project files
*.vcxproj
*.vcxproj.filters
*.suo
*.ply
*.db
*.sln

